# Local development configuration. Copy to .env; never commit real secrets.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional: DATABASE_URL=sqlite:////absolute/path/to/meeting_transcriber.db
# Whisper is loaded only when transcription is requested.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
# Accept the Hugging Face conditions for the configured pyannote model, then set this locally.
# PYANNOTE_AUTH_TOKEN=hf_your_token_here
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
